# ---------------------------------------------------------------------------
# areniX — environment template (no secrets). Copy to .env.local for local dev.
# ---------------------------------------------------------------------------

# MongoDB Community Edition (local server, default port). Database name is part of the URI.
MONGODB_URI=mongodb://127.0.0.1:27017/arenix

# Random 32+ char string used to sign/derive session + invitation tokens.
AUTH_SECRET=

# Public base URL of the site (no trailing slash). Used for canonical URLs, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend). Leave RESEND_API_KEY empty to use the local "demo" logger (emails are stored in DB and printed to the server log; nothing is sent).
RESEND_API_KEY=
EMAIL_FROM="areniX <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL=

# Official areniX business WhatsApp number as E.164 DIGITS ONLY (no +, spaces or dashes).
# Leave empty to hide every WhatsApp action on the site.
NEXT_PUBLIC_WHATSAPP_E164_DIGITS=

# Public business email / phone. Leave empty to hide the corresponding contact rows.
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=

# Scheduling provider. "none" => honest "Request a consultation" form (REQUESTED status, no fake slots).
# "calcom" => embeds the Cal.com link below and accepts verified webhooks at /api/webhooks/calcom.
SCHEDULER_PROVIDER=none
SCHEDULER_PUBLIC_EVENT_LINK=
SCHEDULER_WEBHOOK_SECRET=

# Media uploads. "local" stores files under ./public/uploads (dev only). "s3" needs the S3_* values.
MEDIA_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional privacy-aware analytics (e.g. Plausible domain). Empty => analytics shown as "not configured" in admin.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Bootstrap: used ONLY by `npm run db:create-admin` to create the first SUPER_ADMIN (never read by the web app).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
